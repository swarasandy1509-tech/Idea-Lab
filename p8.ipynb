            "Enter a number:65245\n"
          ]
        }
      ],
      "source": [
        "#Accept a number from the user\n",
        "n=int(input(\"Enter a number:\"))"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Reverse the number using a while loop\n",
        "rev=0\n",
        "while n!=0:\n",
        "    digit = n%10\n",
        "    rev= rev*10+digit\n",
        "    n=n//10"
      ],
      "metadata": {
        "id": "tSLZ3r1YIQSA"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#Displays result\n",
        "print(\"Reverse=\",rev)"
      ],
