      "source": [
        "#Accept number from user\n",
        "n = int(input(\"Enter a number:\"))"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Check whether the number is even or odd\n",
        "if n % 2 == 0:\n",
        "        print(\"Even Number\")\n",
        "else:\n",
        "        print(\"Odd Number\")"
      ],
